# ThreadSanitizer suppressions, used together with cmake/tsan-ignorelist.txt.
#
# Qt is not built with TSan, so TSan cannot see the locks Qt uses in two hand-offs:
# - creating a task: QtConcurrent::run copies the task's lambda on the calling thread and a pool
#   thread runs it;
# - the value in a QFuture: copied in by the producing thread, copied out by the consumer.
# Both entries name Qt frames that never contain our own code, apart from copy constructors.
race:QtConcurrent::NonPromiseTaskResolver
race:QtConcurrent::PromiseTaskResolver
race:QtPrivate::ResultStoreBase
race:QFutureInterface<*>::reportAndEmplaceResult
race:QFutureInterface<*>::reportResult
race:QFutureInterface<*>::resultReference
race:QFuture<*>::result


# A shared_ptr reference count is atomic, but the control block is written with plain stores
# when the object is created. When the shared_ptr then reaches a pool thread through Qt's queue
# (whose locks TSan cannot see) and the pool thread copies it before any of our code runs, TSan
# reports the increment (or, when the pool thread drops its copy first, the decrement) against
# the creation. Only the reference-count updates are suppressed; every other access to the
# object is still checked.
race:__libcpp_atomic_refcount_increment
race:std::__1::__shared_count::__add_shared
race:std::__1::__shared_weak_count::__add_shared
race:__libcpp_atomic_refcount_decrement
race:std::__1::__shared_count::__release_shared
race:std::__1::__shared_weak_count::__release_shared
