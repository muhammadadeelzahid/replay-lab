{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "nogst",
      "displayName": "Debug, without GStreamer",
      "inherits": "debug",
      "cacheVariables": {
        "ABR_WITH_GSTREAMER": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer + UBSan",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer -fsanitize-ignorelist=${sourceDir}/cmake/tsan-ignorelist.txt",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "dist",
      "inherits": "base",
      "displayName": "Release package",
      "description": "Release build for the packages: no GStreamer (the pre-rendered engine with a bundled ffmpeg), no tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ABR_WITH_GSTREAMER": "OFF",
        "ABR_BUILD_TESTS": "OFF",
        "ABR_WARNINGS_AS_ERRORS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "nogst",
      "configurePreset": "nogst"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "dist",
      "configurePreset": "dist"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "environment": {
        "QT_QPA_PLATFORM": "offscreen"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release"
    },
    {
      "name": "nogst",
      "inherits": "base",
      "configurePreset": "nogst"
    },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "UBSAN_OPTIONS": "print_stacktrace=1",
        "LSAN_OPTIONS": "suppressions=${sourceDir}/cmake/lsan.supp"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "configurePreset": "tsan",
      "environment": {
        "QT_QPA_PLATFORM": "offscreen",
        "TSAN_OPTIONS": "second_deadlock_stack=1 halt_on_error=1 suppressions=${sourceDir}/cmake/tsan.supp"
      }
    }
  ]
}
